<?xml version="1.0" encoding="UTF-8"?>
<!--
  Example keymap for service.webostv.
  Copy to userdata/keymaps/ (e.g. special://profile/keymaps/webostv.xml)
  and adjust keys to taste. Every action also works from skins and
  JSONRPC.NotifyAll; see README.md.
-->
<keymap>
  <global>
    <keyboard>
      <f1>RunScript(service.webostv,input,HDMI_1)</f1>
      <f2>RunScript(service.webostv,input,HDMI_2)</f2>
      <f3>RunScript(service.webostv,sound_output,external_arc)</f3>
      <f4>RunScript(service.webostv,sound_output,tv_speaker)</f4>
      <f5>RunScript(service.webostv,app,netflix)</f5>
      <f6>RunScript(service.webostv,toast,Hello from Kodi)</f6>
      <f7>RunScript(service.webostv,screen,off)</f7>
      <f8>RunScript(service.webostv,mute,toggle)</f8>
      <f9>RunScript(service.webostv,volume,down)</f9>
      <f10>RunScript(service.webostv,volume,up)</f10>
      <f11>RunScript(service.webostv,ui)</f11>
      <f12>RunScript(service.webostv,power_off)</f12>
    </keyboard>
    <remote>
      <red>RunScript(service.webostv,button,INPUT_HUB)</red>
      <green>RunScript(service.webostv,ui)</green>
    </remote>
  </global>
</keymap>
